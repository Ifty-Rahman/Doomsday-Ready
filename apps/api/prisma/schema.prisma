generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Movie {
  id          Int     @id @default(autoincrement())
  title       String
  // lower-cased title, so "iron man" and "Iron Man" count as the same movie
  titleKey    String  @unique
  releaseYear Int
  runtime     Int
  watched     Boolean @default(false)

  // movies to watch before this one
  prerequisites Movie[] @relation("Prerequisites")
  // movies that list this one as a prerequisite
  requiredBy    Movie[] @relation("Prerequisites")
}

model Cinema {
  id          Int    @id @default(autoincrement())
  name        String
  // lower-cased name, same idea as Movie.titleKey
  nameKey     String @unique
  bundleSizes Int[]
}
